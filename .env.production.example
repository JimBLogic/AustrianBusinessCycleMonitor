# Public hostname used by Caddy. Point its A/AAAA record to the server first.
DOMAIN=economy.example.com

# Obtain a free key from FRED and keep it out of Git.
FRED_API_KEY=replace_with_your_fred_api_key

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_long_random_value

# Refresh official observations and rebuild the deterministic snapshot every 6 hours.
DATA_REFRESH_SECONDS=21600

# Optional: use a published image instead of building locally.
ABCM_IMAGE=ghcr.io/jimblogic/austrianbusinesscyclemonitor:latest

LOG_LEVEL=INFO
