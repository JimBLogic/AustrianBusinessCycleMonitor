# Public origin used by Caddy. Keep http://localhost for a local smoke run.
# For an Internet-facing VPS, use a DNS name that already points to the host,
# for example: DOMAIN=monitor.example.com
DOMAIN=http://localhost

# Optional. Leave empty to use the application's documented official-source
# fallback mesh. Never commit a real key.
FRED_API_KEY=

ABCM_PUBLIC_ORIGIN=http://localhost
