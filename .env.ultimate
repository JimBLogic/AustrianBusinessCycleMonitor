# =============================================================================
# Austrian Business Cycle Monitor - Ultimate Edition Environment Configuration
# =============================================================================
# Copy this file to .env and configure with your actual API keys and settings

# =============================================================================
# ESSENTIAL CONFIGURATION
# =============================================================================

# Federal Reserve Economic Data (REQUIRED for full functionality)
# Get your free API key from: https://fred.stlouisfed.org/
# Without this, the system will use demo/mock data
FRED_API_KEY=your_fred_api_key_here

# Bitcoin/Gold API keys (optional, for enhanced asset tracking)
BITCOIN_API_KEY=your_bitcoin_api_key_here
GOLD_API_KEY=your_gold_api_key_here

# Flask Application Configuration
SECRET_KEY=your_secret_key_here
FLASK_ENV=production
FLASK_DEBUG=false

# Server Configuration
HOST=127.0.0.1
PORT=5002

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/austrian_monitor.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
# Cache TTL (Time To Live) in seconds
CACHE_TTL_ECONOMIC_DATA=300
CACHE_TTL_BITCOIN_DATA=120
CACHE_TTL_ASSET_DATA=180
CACHE_TTL_BLOCKCHAIN_STATS=60
CACHE_TTL_AUSTRIAN_ANALYSIS=600
CACHE_TTL_SYSTEM_HEALTH=30

# =============================================================================
# API RATE LIMITING
# =============================================================================
# Minimum intervals between API calls (seconds)
RATE_LIMIT_ECONOMIC_DATA=300
RATE_LIMIT_BITCOIN_DATA=120
RATE_LIMIT_ASSET_DATA=180
RATE_LIMIT_FULL_ANALYSIS=600

# =============================================================================
# OPTIONAL API KEYS (For enhanced features)
# =============================================================================

# Alpha Vantage (for additional stock/forex data)
# Get free key from: https://www.alphavantage.co/
ALPHA_VANTAGE_API_KEY=demo

# CoinGecko Pro (for enhanced crypto data, free tier available)
# Get key from: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# Quandl (for additional economic data)
# Get free key from: https://www.quandl.com/
QUANDL_API_KEY=

# World Trading Data (for international markets)
# Get key from: https://www.worldtradingdata.com/
WORLDTRADINGDATA_API_KEY=demo

# IEX Cloud (for stock data)
# Get key from: https://iexcloud.io/
IEX_CLOUD_API_KEY=demo

# =============================================================================
# DATABASE CONFIGURATION (Optional)
# =============================================================================
# SQLite (default, no configuration needed)
DATABASE_URL=sqlite:///data/austrian_monitor.db

# PostgreSQL (for production deployments)
# DATABASE_URL=postgresql://username:password@localhost:5432/austrian_monitor

# Redis (for advanced caching)
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# BITCOIN/BLOCKCHAIN CONFIGURATION
# =============================================================================
# Bitcoin node configuration (optional)
BITCOIN_RPC_HOST=127.0.0.1
BITCOIN_RPC_PORT=8332
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=

# Blockchain API preferences (comma-separated, in order of preference)
BLOCKCHAIN_APIS=mempool.space,blockstream.info,blockchair.com

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# CORS settings
CORS_ORIGINS=http://localhost:5002,http://127.0.0.1:5002

# Session configuration
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# File upload limits
MAX_CONTENT_LENGTH=16777216

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
# WebSocket settings
SOCKETIO_PING_TIMEOUT=60
SOCKETIO_PING_INTERVAL=25

# Thread pool settings
THREAD_POOL_SIZE=10
MAX_WORKERS=4

# Request timeout settings
REQUEST_TIMEOUT=30
CONNECT_TIMEOUT=10

# =============================================================================
# FEATURE TOGGLES
# =============================================================================
# Enable/disable specific features
ENABLE_REAL_TIME_UPDATES=true
ENABLE_BACKGROUND_UPDATES=true
ENABLE_EXPLANATIONS=true
ENABLE_PDF_EXPORT=true
ENABLE_CHARTING=true
ENABLE_MULTILINGUAL=true
ENABLE_ADVANCED_INDICATORS=true

# =============================================================================
# INTERNATIONALIZATION
# =============================================================================
# Default language
DEFAULT_LANGUAGE=en

# Available languages (comma-separated)
SUPPORTED_LANGUAGES=en,es

# =============================================================================
# MONITORING AND ALERTS
# =============================================================================
# System monitoring
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=30

# Alert thresholds
ALERT_HIGH_RISK_THRESHOLD=8
ALERT_CRITICAL_RISK_THRESHOLD=9
ALERT_MEMORY_THRESHOLD=80
ALERT_CPU_THRESHOLD=85

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Development mode settings (only for development)
DEV_MODE=false
DEV_USE_MOCK_DATA=false
DEV_DISABLE_RATE_LIMITING=false
DEV_ENABLE_DEBUG_TOOLBAR=false

# =============================================================================
# EXTERNAL INTEGRATIONS
# =============================================================================
# Webhook URLs for notifications (optional)
WEBHOOK_SLACK=
WEBHOOK_DISCORD=
WEBHOOK_TEAMS=

# Email notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=

# =============================================================================
# DATA STORAGE
# =============================================================================
# Data directory
DATA_DIR=data

# Backup settings
ENABLE_BACKUPS=true
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=30

# Export settings
EXPORT_FORMAT=json,csv,xlsx
MAX_EXPORT_RECORDS=10000

# =============================================================================
# NETWORKING
# =============================================================================
# Proxy settings (if needed)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# DNS settings
DNS_SERVERS=8.8.8.8,8.8.4.4

# =============================================================================
# AUSTRIAN ECONOMICS SPECIFIC
# =============================================================================
# Three Pillars weighting
PILLAR_1_WEIGHT=0.35
PILLAR_2_WEIGHT=0.35
PILLAR_3_WEIGHT=0.30

# Risk assessment parameters
RISK_CALCULATION_METHOD=weighted_average
CONFIDENCE_THRESHOLD=0.70

# Austrian indicators preferences
PREFERRED_GOLD_SOURCE=yahoo
PREFERRED_BITCOIN_SOURCE=coingecko
PREFERRED_ECONOMIC_SOURCE=fred

# =============================================================================
# NOTES
# =============================================================================
# 1. FRED_API_KEY is the most important - get it free from https://fred.stlouisfed.org/
# 2. Most other API keys are optional - system will work with fallbacks
# 3. For production deployment, change SECRET_KEY to a secure random value
# 4. Set FLASK_ENV=production for production deployments
# 5. Consider using Redis for caching in high-traffic environments
# 6. PostgreSQL is recommended for production over SQLite
# 7. Enable SSL/TLS certificates for HTTPS in production
# 8. Review and adjust cache TTL values based on your needs
# 9. Set appropriate CORS_ORIGINS for your deployment domain
# 10. Monitor system resources and adjust thread/worker settings accordingly

# =============================================================================
# SAMPLE FOLDER STRUCTURE & MODULE ORGANIZATION
# =============================================================================
# /config         - Environment configs, YAML, and Python config files
# /data           - Logs, CSVs, reports, and persistent data
# /docs           - Documentation and guides
# /src            - Main Python modules and core logic
#   /utils        - Utility modules (asset, bitcoin, nettime, etc.)
#   /indicators   - Indicator logic and risk models
#   /web_app.py   - Web dashboard entry point
# /templates      - HTML dashboard templates
# /static         - CSS, JS, and static assets
# /app            - Setup, test, and install scripts
# /tests          - Unit and integration tests
#
# All modules should use absolute imports (e.g., from src.utils.asset_prices import AssetPriceManager)
# Use requirements_ultimate.txt for all dependencies
# Place .env.ultimate in the project root and copy to .env for production
#
