  "explanations": {
    "overallRisk": {
      "label": "Puntuación de Riesgo General",
      "explanation": "Medida compuesta de indicadores del ciclo económico austríaco que incluye expansión crediticia, inversión de curva de rendimiento y patrones de malinversión.",
