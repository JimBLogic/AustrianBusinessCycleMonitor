        }
      ]
    },
    "m2GrowthRate": {
      "label": "Crecimiento de Oferta Monetaria M2",
      "explanation": "Cambio interanual en dinero amplio (M2). El crecimiento rápido puede señalar expansión crediticia e inflación de precios potencial en la teoría austríaca.",
      "sources": [
        {
          "title": "FRED: Oferta Monetaria M2 (M2SL)",
          "url": "https://fred.stlouisfed.org/series/M2SL",
          "year": 2025
        },
        {
          "title": "Instituto Mises: Teoría Austríaca del Ciclo Comercial",
          "url": "https://mises.org/library/austrian-theory-trade-cycle-and-other-essays",
          "year": 1978
        }
      ]
    },
    "creditGrowthRate": {
      "label": "Tasa de Crecimiento del Crédito",
      "explanation": "Tasa de expansión de la deuda total del mercado de crédito. La teoría austríaca advierte que la expansión crediticia artificial crea auges insostenibles.",
      "sources": [
        {
          "title": "FRED: Deuda Total del Mercado de Crédito (TCMDO)",
          "url": "https://fred.stlouisfed.org/series/TCMDO",
          "year": 2025
        }
      ]
    },
    "interestRateSpread": {
      "label": "Diferencial de Tasas de Interés",
      "explanation": "Rendimiento del Tesoro a 10 años menos el de 2 años. La inversión (diferencial negativo) a menudo precede las recesiones e indica preferencias temporales distorsionadas.",
      "sources": [
        {
          "title": "FRED: Tesoro a 10 Años (DGS10)",
          "url": "https://fred.stlouisfed.org/series/DGS10",
          "year": 2025
        },
        {
          "title": "FRED: Tesoro a 2 Años (DGS2)",
          "url": "https://fred.stlouisfed.org/series/DGS2",
          "year": 2025
        }
      ]
    },
    "malinvestmentIndex": {
      "label": "Índice de Malinversión",
      "explanation": "Medida compuesta de inversiones insostenibles que incluye empresas zombi, acciones sobrevaluadas y precios inmobiliarios desconectados.",
