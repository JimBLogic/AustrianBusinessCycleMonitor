FROM node:22.14-bookworm-slim

WORKDIR /app
ARG ABCM_PUBLIC_ORIGIN=http://localhost
ENV ABCM_PUBLIC_ORIGIN=${ABCM_PUBLIC_ORIGIN}

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates coreutils curl \
 && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build \
 && mkdir -p /data \
 && chown -R node:node /app /data

USER node

ENV ABCM_DATA_DIR=/data
ENV ABCM_INTERNAL_PORT=8787

EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
  CMD curl -fsS http://127.0.0.1:8787/api/health >/dev/null || exit 1

CMD ["bash", "scripts/run-selfhost.sh"]
