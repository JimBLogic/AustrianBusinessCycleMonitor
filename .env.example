# Example .env file for Austrian Cycle Monitor
# Copy this to .env and add your actual API key

# Get your free API key from: https://fred.stlouisfed.org/
# FRED API Configuration
FRED_API_KEY=your_fred_api_key_here

# Persistent trusted observation and snapshot store.
# Relative paths are resolved from the repository root.
ECONOMIC_DATA_DB=data/economic_data.sqlite3

# Optional: Set log level
LOG_LEVEL=INFO
